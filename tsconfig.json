{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["playwright*.config.ts", "pages/**/*.ts", "tests/**/*.ts", "fixtures/**/*.ts", "support/**/*.ts", "checks/**/*.ts"]
}
