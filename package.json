{
  "name": "saucedemo-booker-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UI checkout and booking API acceptance tests",
  "engines": { "node": "^22.13.0 || >=24" },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "scripts": {
    "test": "node integrations/run-playwright.mjs test",
    "test:ui": "node integrations/run-playwright.mjs test --project=ui-chromium",
    "test:api": "node integrations/run-playwright.mjs test --project=api",
    "testpilot:check": "node integrations/run-playwright.mjs --testpilot-check test",
    "testpilot:mappings": "node integrations/check-testpilot-mappings.mjs",
    "testpilot:retry": "node integrations/retry-testpilot.mjs",
    "testpilot:merge": "node integrations/merge-testpilot.mjs",
    "test:list": "playwright test --list --reporter=list",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "tsx --test checks/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:list",
    "test:stability": "playwright test --repeat-each=5 --workers=1 --retries=0 --fail-on-flaky-tests",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "tsx": "^4.20.0",
    "typescript-eslint": "^8.72.1",
    "typescript": "^5.9.3"
  }
}
